# Copy to .env (git-ignored) and fill in. Never commit .env.

# Meta Model API (OpenAI-compatible)
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Muse Spark Open (open weights) on a Modal Shared Endpoint, used with --model muse-spark-open.
# Create the endpoint: modal endpoint create --shared --name qed-spark-open
#   --model meta-models/Muse-Spark-Open-816B-A42B
# MODAL_API_KEY: a proxy token (modal workspace proxy-tokens create), written as wk-....ws-...
# MODAL_SPARK_OPEN_ENDPOINT: the URL of `modal endpoint info qed-spark-open` without https://,
# e.g. <workspace>--ep-qed-spark-open-server.us-west.modal.direct
MODAL_API_KEY=
MODAL_API_BASE=https://inference.us-west.modal.direct/v1
MODAL_SPARK_OPEN_ENDPOINT=

# Folder holding the reference toolchain builds (llvm-build/, alive2/build/).
# Defaults to ../qed-toolchain next to this repo.
QED_TOOLCHAIN=
